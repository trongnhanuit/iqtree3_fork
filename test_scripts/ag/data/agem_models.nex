#nexus
[ Two-class F81/POISSON mixtures for the --ag-dump-em tests (run_ag_tests.sh --suite agem).
  Rate fields are the paper's convention, 1 - sum(pi^2), so the classes share one event rate. ]
begin models;
frequency EMDA = 0.4 0.1 0.1 0.4;
frequency EMDB = 0.25 0.25 0.25 0.25;
model EMDNA = JC+G4+FMIX{EMDA:0.66:0.6,EMDB:0.75:0.4};
frequency EMP1 = 0.02 0.02 0.02 0.02 0.02 0.02 0.02 0.02 0.02 0.2 0.2 0.02 0.05 0.1 0.02 0.02 0.02 0.02 0.02 0.15;
frequency EMP2 = 0.02 0.08 0.08 0.08 0.02 0.08 0.08 0.08 0.08 0.02 0.02 0.08 0.02 0.02 0.02 0.08 0.08 0.02 0.02 0.02;
model EMAA = POISSON+G4+FMIX{EMP1:0.879:0.55,EMP2:0.932:0.45};
end;
